# =====================================================================
# PlushVerse — variables d'environnement (exemple)
# Copie ce fichier en `.env.local` et remplis les valeurs réelles.
# `.env.local` ne doit JAMAIS être commité.
# =====================================================================

# --- Supabase --------------------------------------------------------
# URL du projet + clé service_role (côté serveur UNIQUEMENT).
# La service_role contourne la RLS : ne jamais l'exposer au client.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=VOTRE_SERVICE_ROLE_KEY

# --- Session (HMAC) ---------------------------------------------------
# Secret utilisé pour signer le cookie de session (32+ caractères aléatoires).
AUTH_SESSION_SECRET=REMPLACEZ_PAR_UN_SECRET_LONG_ET_ALEATOIRE

# --- Simulquest (auth) ------------------------------------------------
# Flux : on redirige vers Simul Account, qui nous renvoie sur
# SIMULQUEST_URL_RETURN avec :
#   ?methode=simulaccountV1&username=…&email=…&token_login=…
# SIMULQUEST_URL_RETURN doit être EXACTEMENT l'URL déclarée dans la table
# `autorizedurl` de Simul Account (avec le même getUniqId), sinon le site
# est refusé. Aucun paramètre ne peut y être ajouté.
SIMULQUEST_LOGIN_URL=https://simulaccount.rf.gd/login.php
SIMULQUEST_GET_UNIQ_ID=VOTRE_GETUNIQID
SIMULQUEST_URL_RETURN=https://VOTRE-DOMAINE/login
# true = compte fictif (dev, tout le monde partage dev-user-1).
# false = vraie connexion Simulquest.
SIMULQUEST_DEV_MODE=true
SIMULQUEST_DEV_USER_ID=dev-user-1
SIMULQUEST_DEV_USER_NAME=Dev Plushie

# --- Marché simulé (admin) --------------------------------------------
# Secret exigé dans le header `x-sim-secret` de /api/market/sim.
# La route est indisponible tant que cette variable n'est pas définie.
MARKET_SIM_SECRET=REMPLACEZ_PAR_UN_SECRET_LONG_ET_ALEATOIRE
